          "name": "z",
          "label": "Z 矩阵",
          "type": "array2d",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "z"],
          "help": "行用 ';' 分隔、单元格用 ',' 分隔，例如 1,20,30;20,1,60;30,60,1。"
        },
        {
          "name": "colorscale",
          "label": "色标",
          "type": "enum",
          "default": "Greens",
          "path": ["data", 0, "colorscale"],
          "help": "用于表示单元格强度的颜色渐变。",
          "options": [
            { "value": "Greens", "label": "绿色系" },
            { "value": "Blues", "label": "蓝色系" },
            { "value": "Viridis", "label": "Viridis" },
            { "value": "RdBu", "label": "红蓝" },
            { "value": "YlGnBu", "label": "黄绿蓝" }
          ]
        }
      ]
    },
    {
      "id": "dual_axis",
