    {
      "id": "heatmap",
      "label": "热力图",
      "tags": ["heatmap", "matrix", "2d"],
      "traces": [
        { "index": 0, "type": "heatmap" }
      ],
      "example": {
        "layout": { "title": "基础热力图" },
        "data": [
          { "type": "heatmap", "z": [[1, 20, 30], [20, 1, 60], [30, 60, 1]], "colorscale": "Greens" }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
