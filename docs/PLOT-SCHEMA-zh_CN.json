{
  "schema": "1.0",
  "plot_types": [
    {
      "id": "line",
      "label": "折线图",
      "tags": ["line", "scatter", "2d"],
      "traces": [
        { "index": 0, "type": "scatter", "mode": "lines" }
      ],
      "example": {
        "layout": { "title": "基础折线图", "showlegend": true },
        "data": [
          { "type": "scatter", "mode": "lines", "x": [0, 1, 2, 3], "y": [1, 3, 2, 4], "line": { "width": 2, "color": "#1f77b4" } }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的折线图",
          "path": ["layout", "title"],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "x",
          "label": "X 轴数据",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "x"],
          "help": "逗号分隔的数字，例如 0,1,2,3。"
        },
        {
          "name": "y",
          "label": "Y 轴数据",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "y"],
          "help": "逗号分隔的数字，每个 x 值对应一个。"
        },
        {
          "name": "line_width",
          "label": "线宽",
          "type": "number",
          "default": 2,
          "min": 0,
          "max": 20,
          "path": ["data", 0, "line", "width"],
          "help": "线条的像素宽度。"
        },
        {
          "name": "color",
          "label": "颜色",
          "type": "enum",
          "default": "#1f77b4",
          "path": ["data", 0, "line", "color"],
          "help": "线条颜色。",
          "options": [
            { "value": "#1f77b4", "label": "蓝色" },
            { "value": "#3D5230", "label": "苔藓绿" },
            { "value": "#d62728", "label": "红色" },
            { "value": "#ff7f0e", "label": "橙色" },
            { "value": "#9467bd", "label": "紫色" },
            { "value": "#2ca02c", "label": "绿色" }
          ]
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": ["layout", "showlegend"],
          "help": "是否显示轨迹图例。"
        }
      ]
    },
