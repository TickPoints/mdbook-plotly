{
  "schema": "2.0",
  "trace_fields": [
    {
      "name": "name",
      "label": "轨迹名称",
      "type": "string",
      "path": [
        "name"
      ],
      "help": "在图例中显示的轨迹名称（可选）。"
    },
    {
      "name": "type",
      "label": "轨迹类型",
      "type": "enum",
      "path": [
        "type"
      ],
      "help": "覆盖图表类型的基础轨迹类型；自动时继承。",
      "options": [
        {
          "value": "default",
          "label": "自动"
        },
        {
          "value": "scatter",
          "label": "散点"
        },
        {
          "value": "bar",
          "label": "柱形"
        },
        {
          "value": "pie",
          "label": "饼图"
        },
        {
          "value": "histogram",
          "label": "直方图"
        },
        {
          "value": "box",
          "label": "箱线图"
        },
        {
          "value": "heatmap",
          "label": "热力图"
        }
      ]
    },
    {
      "name": "mode",
      "label": "轨迹模式",
      "type": "enum",
      "path": [
        "mode"
      ],
      "help": "轨迹的绘制方式；自动时继承图表类型的模式。",
      "options": [
        {
          "value": "default",
          "label": "自动"
        },
        {
          "value": "lines",
          "label": "线段"
        },
        {
          "value": "markers",
          "label": "散点"
        },
        {
          "value": "lines+markers",
          "label": "线段 + 散点"
        }
      ]
    },
    {
      "name": "x",
      "label": "X 轴数据",
      "type": "array",
      "item_type": "number",
      "path": [
        "x"
      ],
      "help": "逗号分隔的数字，例如 0,1,2,3。"
    },
    {
      "name": "y",
      "label": "Y 轴数据",
      "type": "array",
      "item_type": "number",
      "path": [
        "y"
      ],
      "help": "逗号分隔的数字，每个 x 值对应一个。"
    },
    {
      "name": "z",
      "label": "Z 矩阵",
      "type": "array2d",
      "item_type": "number",
      "path": [
        "z"
      ],
      "help": "行用 ';' 分隔、单元格用 ',' 分隔，例如 1,20,30;20,1,60;30,60,1。"
    },
    {
      "name": "labels",
      "label": "标签",
      "type": "array",
      "item_type": "string",
      "path": [
        "labels"
      ],
      "help": "逗号分隔的标签，每个扇区或类别对应一个。"
    },
    {
      "name": "values",
      "label": "扇区大小",
      "type": "array",
      "item_type": "number",
      "path": [
        "values"
      ],
      "help": "逗号分隔的数值，每个标签对应一个。"
    },
    {
      "name": "yaxis",
      "label": "Y 轴",
      "type": "enum",
      "path": [
        "yaxis"
      ],
      "help": "轨迹使用的纵轴；自动时选择第一条。",
      "options": [
        {
          "value": "default",
          "label": "自动"
        },
        {
          "value": "y",
          "label": "左侧 (y)"
        },
        {
          "value": "y2",
          "label": "右侧 (y2)"
        }
      ]
    },
    {
      "name": "color",
      "label": "颜色",
      "type": "enum",
      "paths": [
        [
          "line",
          "color"
        ],
        [
          "marker",
          "color"
        ]
      ],
      "help": "轨迹颜色。",
      "options": [
        {
          "value": "#1f77b4",
          "label": "蓝色"
        },
        {
          "value": "#3D5230",
          "label": "苔藓绿"
        },
        {
          "value": "#d62728",
          "label": "红色"
        },
        {
          "value": "#ff7f0e",
          "label": "橙色"
        },
        {
          "value": "#9467bd",
          "label": "紫色"
        },
        {
          "value": "#2ca02c",
          "label": "绿色"
        }
      ]
    },
    {
      "name": "colorscale",
      "label": "色标",
      "type": "enum",
      "path": [
        "colorscale"
      ],
      "help": "用于表示单元格强度的颜色渐变。",
      "options": [
        {
          "value": "default",
          "label": "自动"
        },
        {
          "value": "Greens",
          "label": "绿色系"
        },
        {
          "value": "Blues",
          "label": "蓝色系"
        },
        {
          "value": "Viridis",
          "label": "Viridis"
        },
        {
          "value": "RdBu",
          "label": "红蓝"
        },
        {
          "value": "YlGnBu",
          "label": "黄绿蓝"
        }
      ],
      "default": "default"
    },
    {
      "name": "opacity",
      "label": "不透明度",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "path": [
        "opacity"
      ],
      "help": "轨迹不透明度，从 0（透明）到 1（不透明）。"
    },
    {
      "name": "line_width",
      "label": "线宽",
      "type": "number",
      "default": 2,
      "min": 0,
      "max": 20,
      "path": [
        "line",
        "width"
      ],
      "help": "线条的像素宽度。"
    },
    {
      "name": "marker_size",
      "label": "标记大小",
      "type": "number",
      "default": 10,
      "min": 0,
      "max": 50,
      "path": [
        "marker",
        "size"
      ],
      "help": "标记的像素直径。"
    }
  ],
  "global_fields": [
    {
      "name": "config",
      "label": "配置 (JSON5)",
      "type": "json",
      "path": [
        "config"
      ],
      "help": "以 JSON5 编写的 Plotly 配置对象，例如 { responsive: true, scrollZoom: false }。"
    },
    {
      "name": "map",
      "label": "映射表达式 (JSON5)",
      "type": "json",
      "path": [
        "map"
      ],
      "help": "名称到值或生成器的映射，例如 { n: { type: 'g-choose', options: [1, 2, 3] } }。"
    }
  ],
  "plot_types": [
    {
      "id": "line",
      "label": "折线图",
      "tags": [
        "line",
        "scatter",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "scatter",
        "mode": "lines"
      },
      "required_data": [
        "x",
        "y"
      ],
      "example": {
        "layout": {
          "title": "基础折线图",
          "showlegend": true
        },
        "data": [
          {
            "type": "scatter",
            "mode": "lines",
            "x": [
              0,
              1,
              2,
              3
            ],
            "y": [
              1,
              3,
              2,
              4
            ],
            "line": {
              "width": 2,
              "color": "#1f77b4"
            }
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的折线图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示轨迹图例。"
        }
      ]
    },
    {
      "id": "scatter",
      "label": "散点图",
      "tags": [
        "scatter",
        "marker",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "scatter",
        "mode": "markers"
      },
      "required_data": [
        "x",
        "y"
      ],
      "example": {
        "layout": {
          "title": "基础散点图",
          "showlegend": true
        },
        "data": [
          {
            "type": "scatter",
            "mode": "markers",
            "x": [
              0,
              1,
              2,
              3,
              4
            ],
            "y": [
              2,
              5,
              3,
              6,
              1
            ],
            "opacity": 0.7,
            "marker": {
              "size": 10,
              "color": "#1f77b4"
            }
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的散点图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示轨迹图例。"
        }
      ]
    },
    {
      "id": "bar",
      "label": "柱状图",
      "tags": [
        "bar",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "bar"
      },
      "required_data": [
        "x",
        "y"
      ],
      "example": {
        "layout": {
          "title": "基础柱状图",
          "showlegend": true
        },
        "data": [
          {
            "type": "bar",
            "x": [
              1,
              2,
              3,
              4
            ],
            "y": [
              4,
              7,
              3,
              9
            ],
            "marker": {
              "color": "#1f77b4"
            }
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的柱状图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示轨迹图例。"
        }
      ]
    },
    {
      "id": "pie",
      "label": "饼图",
      "tags": [
        "pie",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "pie"
      },
      "required_data": [
        "labels",
        "values"
      ],
      "example": {
        "layout": {
          "title": "基础饼图",
          "showlegend": true
        },
        "data": [
          {
            "type": "pie",
            "values": [
              10,
              20,
              30,
              40
            ],
            "labels": [
              "甲",
              "乙",
              "丙",
              "丁"
            ]
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的饼图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示扇区图例。"
        }
      ]
    },
    {
      "id": "histogram",
      "label": "直方图",
      "tags": [
        "histogram",
        "distribution",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "histogram"
      },
      "required_data": [
        "x"
      ],
      "example": {
        "layout": {
          "title": "基础直方图",
          "showlegend": true
        },
        "data": [
          {
            "type": "histogram",
            "x": [
              1,
              2,
              2,
              3,
              3,
              3,
              4,
              4,
              5
            ],
            "marker": {
              "color": "#1f77b4"
            }
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的直方图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示轨迹图例。"
        }
      ]
    },
    {
      "id": "box",
      "label": "箱线图",
      "tags": [
        "box",
        "distribution",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "box"
      },
      "required_data": [
        "y"
      ],
      "example": {
        "layout": {
          "title": "基础箱线图",
          "showlegend": true
        },
        "data": [
          {
            "type": "box",
            "y": [
              1,
              2,
              3,
              5,
              8,
              13,
              4,
              6,
              7,
              9
            ],
            "marker": {
              "color": "#1f77b4"
            }
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的箱线图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示轨迹图例。"
        }
      ]
    },
    {
      "id": "heatmap",
      "label": "热力图",
      "tags": [
        "heatmap",
        "matrix",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "heatmap"
      },
      "required_data": [
        "z"
      ],
      "example": {
        "layout": {
          "title": "基础热力图"
        },
        "data": [
          {
            "type": "heatmap",
            "z": [
              [
                1,
                20,
                30
              ],
              [
                20,
                1,
                60
              ],
              [
                30,
                60,
                1
              ]
            ],
            "colorscale": "Greens"
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "我的热力图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": false,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示轨迹图例。"
        }
      ]
    },
    {
      "id": "dual_axis",
      "label": "双轴图",
      "tags": [
        "scatter",
        "bar",
        "axis",
        "2d"
      ],
      "trace_defaults": {
        "index": 0,
        "type": "bar"
      },
      "required_data": [
        "x",
        "y"
      ],
      "example": {
        "layout": {
          "title": "双轴图",
          "showlegend": true,
          "yaxis2": {
            "side": "right"
          }
        },
        "data": [
          {
            "type": "bar",
            "x": [
              1,
              2,
              3,
              4
            ],
            "y": [
              10,
              15,
              13,
              17
            ],
            "marker": {
              "color": "#1f77b4"
            }
          },
          {
            "type": "scatter",
            "mode": "lines",
            "x": [
              1,
              2,
              3,
              4
            ],
            "y": [
              0.4,
              0.6,
              0.55,
              0.8
            ],
            "yaxis": "y2",
            "line": {
              "color": "#d62728"
            }
          }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "图表标题",
          "type": "string",
          "default": "双轴图",
          "path": [
            "layout",
            "title"
          ],
          "help": "显示在图表顶部的标题。"
        },
        {
          "name": "y2_side",
          "label": "第二轴位置",
          "type": "enum",
          "default": "right",
          "path": [
            "layout",
            "yaxis2",
            "side"
          ],
          "help": "第二条 y 轴位于图表的哪一侧。",
          "options": [
            {
              "value": "right",
              "label": "右侧"
            },
            {
              "value": "left",
              "label": "左侧"
            }
          ]
        },
        {
          "name": "show_legend",
          "label": "显示图例",
          "type": "bool",
          "default": true,
          "path": [
            "layout",
            "showlegend"
          ],
          "help": "是否显示轨迹图例。"
        }
      ]
    }
  ]
}
