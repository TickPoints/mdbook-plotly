            { "value": "#d62728", "label": "红色" },
            { "value": "#ff7f0e", "label": "橙色" },
            { "value": "#9467bd", "label": "紫色" },
            { "value": "#2ca02c", "label": "绿色" }
          ]
        },
        {
          "name": "line_color",
          "label": "折线颜色",
          "type": "enum",
          "default": "#d62728",
          "path": ["data", 1, "line", "color"],
