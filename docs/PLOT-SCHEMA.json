    {
      "id": "pie",
      "label": "Pie",
      "tags": ["pie", "2d"],
      "traces": [
        { "index": 0, "type": "pie" }
      ],
      "example": {
        "layout": { "title": "Basic Pie", "showlegend": true },
        "data": [
          { "type": "pie", "values": [10, 20, 30, 40], "labels": ["A", "B", "C", "D"], "hole": 0 }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "Chart title",
          "type": "string",
          "default": "My Pie Chart",
          "path": ["layout", "title"],
          "help": "Title shown at the top of the chart."
        },
        {
          "name": "values",
          "label": "Sizes",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "values"],
          "help": "Comma-separated slice sizes, e.g. 10,20,30,40."
        },
        {
          "name": "labels",
          "label": "Labels",
          "type": "array",
          "item_type": "string",
          "path": ["data", 0, "labels"],
          "help": "Comma-separated slice labels, one per size."
        },
        {
          "name": "hole",
          "label": "Hole size",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 0.9,
          "path": ["data", 0, "hole"],
          "help": "Donut hole radius as a fraction of the pie."
        },
        {
          "name": "show_legend",
          "label": "Show legend",
          "type": "bool",
          "default": true,
          "path": ["layout", "showlegend"],
          "help": "Whether to display the slice legend."
        }
      ]
    },
    {
      "id": "histogram",
