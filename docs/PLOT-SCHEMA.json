      "traces": [
        { "index": 0, "type": "histogram" }
      ],
      "example": {
        "layout": { "title": "Basic Histogram", "showlegend": true },
        "data": [
          { "type": "histogram", "x": [1, 2, 2, 3, 3, 3, 4, 4, 5], "nbinsx": 10, "marker": { "color": "#1f77b4" } }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "Chart title",
          "type": "string",
          "default": "My Histogram",
          "path": ["layout", "title"],
          "help": "Title shown at the top of the chart."
        },
        {
          "name": "x",
          "label": "Sample data",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "x"],
          "help": "Comma-separated samples to bin."
        },
        {
          "name": "nbinsx",
          "label": "Number of bins",
          "type": "number",
          "default": 10,
          "min": 1,
          "max": 100,
          "path": ["data", 0, "nbinsx"],
          "help": "How many buckets to divide the range into."
        },
        {
          "name": "color",
          "label": "Color",
          "type": "enum",
          "default": "#1f77b4",
          "path": ["data", 0, "marker", "color"],
          "help": "Bar fill color.",
          "options": [
            { "value": "#1f77b4", "label": "Blue" },
            { "value": "#3D5230", "label": "Moss green" },
            { "value": "#d62728", "label": "Red" },
            { "value": "#ff7f0e", "label": "Orange" },
            { "value": "#9467bd", "label": "Purple" },
            { "value": "#2ca02c", "label": "Green" }
          ]
        },
        {
          "name": "show_legend",
          "label": "Show legend",
          "type": "bool",
          "default": true,
          "path": ["layout", "showlegend"],
          "help": "Whether to display the trace legend."
        }
      ]
    },
    {
      "id": "box",
      "label": "Box",
      "tags": ["box", "distribution", "2d"],
      "traces": [
        { "index": 0, "type": "box" }
      ],
      "example": {
        "layout": { "title": "Basic Box", "showlegend": true },
        "data": [
          { "type": "box", "y": [1, 2, 3, 5, 8, 13, 4, 6, 7, 9], "notched": false }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "Chart title",
          "type": "string",
          "default": "My Box Plot",
          "path": ["layout", "title"],
          "help": "Title shown at the top of the chart."
        },
        {
          "name": "y",
          "label": "Values",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "y"],
          "help": "Comma-separated samples to summarise."
        },
        {
          "name": "notched",
          "label": "Notched",
          "type": "bool",
          "default": false,
          "path": ["data", 0, "notched"],
          "help": "Draw a confidence-interval notch on the median."
        },
        {
          "name": "show_legend",
          "label": "Show legend",
          "type": "bool",
          "default": true,
          "path": ["layout", "showlegend"],
          "help": "Whether to display the trace legend."
        }
      ]
    },
    {
      "id": "heatmap",
      "label": "Heatmap",
      "tags": ["heatmap", "matrix", "2d"],
      "traces": [
        { "index": 0, "type": "heatmap" }
      ],
      "example": {
        "layout": { "title": "Basic Heatmap" },
        "data": [
          { "type": "heatmap", "z": [[1, 20, 30], [20, 1, 60], [30, 60, 1]], "colorscale": "Greens" }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "Chart title",
          "type": "string",
          "default": "My Heatmap",
          "path": ["layout", "title"],
          "help": "Title shown at the top of the chart."
        },
        {
          "name": "z",
          "label": "Z matrix",
          "type": "array2d",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "z"],
          "help": "Rows separated by ';', cells by ',', e.g. 1,20,30;20,1,60;30,60,1."
        },
        {
          "name": "colorscale",
          "label": "Color scale",
          "type": "enum",
          "default": "Greens",
          "path": ["data", 0, "colorscale"],
          "help": "The colour ramp used for cell intensity.",
          "options": [
            { "value": "Greens", "label": "Greens" },
            { "value": "Blues", "label": "Blues" },
            { "value": "Viridis", "label": "Viridis" },
            { "value": "RdBu", "label": "Red-Blue" },
            { "value": "YlGnBu", "label": "Yellow-Green-Blue" }
          ]
        }
      ]
    },
    {
      "id": "dual_axis",
      "label": "Dual axis",
      "tags": ["scatter", "bar", "axis", "2d"],
      "traces": [
        { "index": 0, "type": "bar" },
        { "index": 1, "type": "scatter", "mode": "lines", "yaxis": "y2" }
      ],
      "example": {
        "layout": { "title": "Dual Axis", "showlegend": true, "yaxis2": { "side": "right" } },
        "data": [
          { "type": "bar", "x": [1, 2, 3, 4], "y": [10, 15, 13, 17], "marker": { "color": "#1f77b4" } },
          { "type": "scatter", "mode": "lines", "x": [1, 2, 3, 4], "y": [0.4, 0.6, 0.55, 0.8], "yaxis": "y2", "line": { "color": "#d62728" } }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "Chart title",
          "type": "string",
          "default": "Dual Axis Chart",
          "path": ["layout", "title"],
          "help": "Title shown at the top of the chart."
        },
        {
          "name": "x",
          "label": "Shared X data",
          "type": "array",
          "item_type": "number",
          "required": true,
          "paths": [["data", 0, "x"], ["data", 1, "x"]],
          "help": "Comma-separated numbers shared by both traces."
        },
        {
          "name": "y_bar",
          "label": "Bar Y data",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "y"],
          "help": "Comma-separated bar heights."
        },
        {
          "name": "y_line",
          "label": "Line Y data",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 1, "y"],
          "help": "Comma-separated line values on the second axis."
        },
        {
          "name": "bar_color",
          "label": "Bar color",
          "type": "enum",
          "default": "#1f77b4",
          "path": ["data", 0, "marker", "color"],
          "help": "Bar fill color.",
          "options": [
            { "value": "#1f77b4", "label": "Blue" },
            { "value": "#3D5230", "label": "Moss green" },
            { "value": "#d62728", "label": "Red" },
            { "value": "#ff7f0e", "label": "Orange" },
            { "value": "#9467bd", "label": "Purple" },
            { "value": "#2ca02c", "label": "Green" }
          ]
        },
        {
          "name": "line_color",
          "label": "Line color",
          "type": "enum",
          "default": "#d62728",
          "path": ["data", 1, "line", "color"],
          "help": "Line color on the second axis.",
          "options": [
            { "value": "#1f77b4", "label": "Blue" },
            { "value": "#3D5230", "label": "Moss green" },
            { "value": "#d62728", "label": "Red" },
            { "value": "#ff7f0e", "label": "Orange" },
            { "value": "#9467bd", "label": "Purple" },
            { "value": "#2ca02c", "label": "Green" }
          ]
        },
        {
          "name": "y2_side",
          "label": "Second axis side",
          "type": "enum",
          "default": "right",
          "path": ["layout", "yaxis2", "side"],
          "help": "Which side of the plot the second y-axis sits on.",
          "options": [
            { "value": "right", "label": "Right" },
            { "value": "left", "label": "Left" }
          ]
        },
        {
          "name": "show_legend",
          "label": "Show legend",
          "type": "bool",
          "default": true,
          "path": ["layout", "showlegend"],
          "help": "Whether to display the trace legend."
        }
      ]
    }
  ]
}
