{
  "schema": "1.0",
  "plot_types": [
    {
      "id": "line",
      "label": "Line",
      "tags": ["line", "scatter", "2d"],
      "traces": [
        { "index": 0, "type": "scatter", "mode": "lines" }
      ],
      "example": {
        "layout": { "title": "Basic Line", "showlegend": true },
        "data": [
          { "type": "scatter", "mode": "lines", "x": [0, 1, 2, 3], "y": [1, 3, 2, 4], "line": { "width": 2, "color": "#1f77b4" } }
        ]
      },
      "fields": [
        {
          "name": "title",
          "label": "Chart title",
          "type": "string",
          "default": "My Line Chart",
          "path": ["layout", "title"],
          "help": "Title shown at the top of the chart."
        },
        {
          "name": "x",
          "label": "X data",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "x"],
          "help": "Comma-separated numbers, e.g. 0,1,2,3."
        },
        {
          "name": "y",
          "label": "Y data",
          "type": "array",
          "item_type": "number",
          "required": true,
          "path": ["data", 0, "y"],
          "help": "Comma-separated numbers, one per x value."
        },
        {
          "name": "line_width",
          "label": "Line width",
          "type": "number",
          "default": 2,
          "min": 0,
          "max": 20,
          "path": ["data", 0, "line", "width"],
          "help": "Stroke width in pixels."
        },
        {
          "name": "color",
          "label": "Color",
          "type": "enum",
          "default": "#1f77b4",
          "path": ["data", 0, "line", "color"],
          "help": "Line color.",
          "options": [
            { "value": "#1f77b4", "label": "Blue" },
            { "value": "#3D5230", "label": "Moss green" },
            { "value": "#d62728", "label": "Red" },
            { "value": "#ff7f0e", "label": "Orange" },
            { "value": "#9467bd", "label": "Purple" },
            { "value": "#2ca02c", "label": "Green" }
          ]
        },
        {
          "name": "show_legend",
          "label": "Show legend",
          "type": "bool",
          "default": true,
          "path": ["layout", "showlegend"],
          "help": "Whether to display the trace legend."
        }
      ]
    },
    {
      "id": "scatter",
