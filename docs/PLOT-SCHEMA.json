        "layout": { "title": "Basic Scatter", "showlegend": true },
        "data": [
          { "type": "scatter", "mode": "markers", "x": [0, 1, 2, 3, 4], "y": [2, 5, 3, 6, 1], "marker": { "size": 10, "opacity": 0.7, "color": "#1f77b4" } }
